# ── Formulario de contacto (solo servidor: NO usar el prefijo VITE_) ──
# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Casilla que recibe las consultas
CONTACT_TO_EMAIL=belcel.devs@gmail.com
# Remitente. Sin dominio propio verificado en Resend, dejar este valor.
CONTACT_FROM_EMAIL=BelCel Web <onboarding@resend.dev>
# (Opcional) otros dominios desde los que se permite enviar el formulario, separados por coma
ALLOWED_ORIGINS=

# ── Sitio ──
# URL pública del sitio, sin barra final (SEO / vista previa en redes)
VITE_SITE_URL=https://belcel.vercel.app
